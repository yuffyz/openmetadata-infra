# Reverse proxy that injects the tab-title script into the OpenMetadata UI.
#
# Everything is passed through untouched except one thing: a single <script> tag
# is added to the served HTML. The script itself is served from this proxy at
# /_brand/title.js rather than inlined, so the sub_filter replacement stays a
# short string with no quoting to get wrong.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 8080;
  server_name _;

  # Accept-Encoding is stripped on the way upstream (below) so that sub_filter
  # can read the HTML body -- it cannot rewrite a gzipped response. Compression
  # is therefore re-applied here, so clients still get a compressed payload and
  # only the hop inside the cluster is uncompressed.
  gzip              on;
  gzip_proxied      any;
  gzip_min_length   1024;
  gzip_types        text/html text/css text/plain application/javascript application/json image/svg+xml;

  # Served locally, so it stays available even when the app behind is not --
  # which is what makes it a safe readiness probe for this pod.
  location = /_brand/title.js {
    alias /etc/nginx/brand/brand-title.js;
    default_type application/javascript;
    add_header Cache-Control "no-cache";
  }

  location / {
    proxy_pass http://${upstream};
    proxy_http_version 1.1;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # WebSocket / SSE upgrade, for the activity feed.
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # See the gzip note above.
    proxy_set_header Accept-Encoding "";

    sub_filter      '</head>' '<script src="/_brand/title.js" defer></script></head>';
    sub_filter_once on;
    sub_filter_types text/html;

    # Buffering off so server-sent events reach the browser as they happen
    # rather than in blocks; the read timeout matches the ALB's idle timeout.
    proxy_buffering    off;
    proxy_read_timeout 300s;
  }
}
